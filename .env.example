# Copy to .env and fill in. .env is gitignored.

# --- Core generation ---
LEONARDO_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- OpenRouter (optional alternative to local Ollama) ---
# Once this key is set, picking an OpenRouter model id (e.g. "z-ai/glm-5.3-flash",
# or any ":free" model) from the Ollama Model dropdown routes there instead --
# llm_client.py detects it by the "/" in the id, no separate provider switch
# needed. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Image provider: 'local' (on-device SD via sd_server.py), 'pollinations' (free hosted), or 'leonardo' ---
#
# Image sharpness is decided here. Video is delivered at 1080x1920, and any
# provider that generates smaller has to be upscaled -- which cannot add detail
# back. Measured ceilings:
#   pollinations  576x1024  -> upscaled 1.88x  (free tier ignores larger requests)
#   local (SDXL)  768x1344  -> upscaled 1.41x  (free, on-device, no cap but your hardware)
IMAGE_PROVIDER=pollinations
SD_SERVER_URL=http://localhost:8001

# Local model. Must be an SDXL-class model: SDXL is trained at ~1024px, whereas
# sd-turbo is SD2.1 trained at 512x512 and visibly duplicates limbs and faces
# when asked for tall 9:16 frames.
#   stabilityai/sdxl-turbo    fast, 6 steps, good coherence
#   SG161222/RealVisXL_V5.0   slowest, 28 steps, most photorealistic faces
#   RunDiffusion/Juggernaut-XL-v9  25 steps, cinematic look
LOCAL_SD_MODEL=stabilityai/sdxl-turbo
# LOCAL_SD_STEPS / LOCAL_SD_GUIDANCE / LOCAL_SD_DEVICE are optional overrides.
# LOCAL_SD_DTYPE defaults to float16 on GPU: SDXL in float32 is ~14GB of weights
# and will thrash on a 16GB machine (one 576x1024 image took 30 minutes).

# --- Hailuo Animated Video (MiniMax) ---
# Used by the "Hailuo Animated Video" visual mode (e.g. animated stickman videos).
# Free trial credits on signup at https://platform.minimax.io
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimax.io   # optional; default global endpoint

# --- RAG fact-checking web search (optional; falls back to free DuckDuckGo) ---
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# --- Pexels (landscape / long-form stock video) ---
PEXELS_API_KEY=

# --- Failure alerting (optional; reliability layer) ---
# Telegram: message @BotFather to create a bot, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic incoming webhook (Slack or Discord compatible).
ALERT_WEBHOOK_URL=

# --- Cost / budget guard (optional) ---
# Daily ceiling in cost units; unset or 0 disables the guard. A render is
# refused up-front if it would push the day's spend past this.
LEONARDO_DAILY_BUDGET=
LEONARDO_IMAGE_COST=1.0
LEONARDO_MOTION_COST=5.0

# Conservative per-attempt Hailuo cost units, tracked separately from Leonardo.
HAILUO_DAILY_BUDGET=
HAILUO_MOTION_COST=5.0

# Local server and browser access. Run a single backend process.
BACKEND_HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
